/-!
# Iterated derivatives of a transform along a divided coordinate

In the chart of the blow-up of `P = (x₀, …, x_r)` dividing by `x_r`
(`Hironaka/Algebra/Local/TransformDeriv.lean`), [Kol07, (75.1)] says that for a divided coordinate
`x_h`, `h < r`, differentiation with respect to `x_h` commutes with the transform:
`∂'_h π⁻¹_*(f, m+1) = π⁻¹_*(∂_h f, m)`. Iterating `j` times gives, for `f ∈ Pᵐ` and `j ≤ m`,
`∂'_h^j π⁻¹_*(f, m) = π⁻¹_*(∂_h^j f, m − j)` (`iterate_chartDerivRing_transformElem`), and hence,
for `I ≤ Pᵐ` and `f ∈ I`, the `j`-fold `∂'_h`-derivative of the generator `π⁻¹_*(f, m)` of
`π⁻¹_*(I, m)` lies in `π⁻¹_*(D^j I, m − j)`, because `∂_h^j f ∈ D^j I`
(`iterate_chartDerivRing_transformElem_mem`).

This is the observation of the proof of [Kol07, Theorem 88] that, "by (75.1)", differentiation
commutes with the birational transform for `∂/∂x₁` and `∂/∂y₁`. It is stated here for the
generators `π⁻¹_*(f, m)`, `f ∈ I`, of the transform and not for all its elements: the ideal
generated by the `j`-fold `∂'_h`-derivatives of all elements of `π⁻¹_*(I, m)` need not lie in
`π⁻¹_*(D^j I, m − j)` (`HironakaExamples/Theorem88Counterexample.lean`). The statement on
generators suffices for the inclusion `⊆` of [Kol07, (88.1)], proved in
`Hironaka/Algebra/Local/TransformDerivNormalForm.lean`.
-/

public section

namespace IsLocalRing

section Congr

variable {R : Type*} [CommRing R] {n : ℕ} (x : Fin n → R) (r : Fin n)

/-- Transformed elements of equal elements with equal marks are equal (the membership proofs are
irrelevant). -/
theorem transformElem_congr {f₁ f₂ : R} (hf : f₁ = f₂) {m₁ m₂ : ℕ} (hm : m₁ = m₂)
    (hf₁ : f₁ ∈ chartCenter x r ^ m₁) (hf₂ : f₂ ∈ chartCenter x r ^ m₂) :
    transformElem x r f₁ hf₁ = transformElem x r f₂ hf₂ := by
  subst hf hm
  rfl

end Congr

namespace RegularCoords

variable {R : Type*} [CommRing R] [IsRegularLocalRing R] [Algebra ℚ R] {n : ℕ}
  (c : RegularCoords R n) (r : Fin n)

/-- [Kol07, (75.1)] iterated (the proof of [Kol07, Theorem 88]): in the chart dividing by `x_r`,
for `h < r`, `f ∈ Pᵐ` and `j ≤ m`, `∂'_h^j π⁻¹_*(f, m) = π⁻¹_*(∂_h^j f, m − j)`. -/
theorem iterate_chartDerivRing_transformElem {h : Fin n} (hh : h < r) {m : ℕ} {f : R}
    (hf : f ∈ chartCenter c.x r ^ m) {j : ℕ} (hj : j ≤ m) :
    ∃ hf' : (⇑(c.pderiv h))^[j] f ∈ chartCenter c.x r ^ (m - j),
      (⇑(c.chartDerivRing r h))^[j] (transformElem c.x r f hf) =
        transformElem c.x r ((⇑(c.pderiv h))^[j] f) hf' := by
  induction j with
  | zero => exact ⟨hf, rfl⟩
  | succ j ih =>
    obtain ⟨hf', heq⟩ := ih (Nat.le_of_succ_le hj)
    -- the mark `m − j` is `(m − (j + 1)) + 1`, so (75.1) applies once more
    have hf'' : (⇑(c.pderiv h))^[j] f ∈ chartCenter c.x r ^ (m - (j + 1) + 1) := by
      rwa [show m - (j + 1) + 1 = m - j by omega]
    have hnext : (⇑(c.pderiv h))^[j + 1] f ∈ chartCenter c.x r ^ (m - (j + 1)) := by
      rw [Function.iterate_succ_apply']
      have := c.pderiv_mem_chartCenter_pow r hf'' h
      rwa [Nat.add_sub_cancel] at this
    refine ⟨hnext, ?_⟩
    rw [Function.iterate_succ_apply', heq, transformElem_congr c.x r rfl (by omega) hf' hf'',
      ← c.transform_pderiv_lt r hh hf'']
    exact transformElem_congr c.x r (Function.iterate_succ_apply' _ _ _).symm rfl _ _

/-- For `I ≤ Pᵐ`, `f ∈ I` and `j ≤ m`, the `j`-fold `∂'_h`-derivative of the generator
`π⁻¹_*(f, m)` lies in the transform of `D^j I`:
`∂'_h^j π⁻¹_*(f, m) = π⁻¹_*(∂_h^j f, m − j) ∈ π⁻¹_*(D^j I, m − j)`. -/
theorem iterate_chartDerivRing_transformElem_mem {h : Fin n} (hh : h < r) {I : Ideal R} {m : ℕ}
    (hI : I ≤ chartCenter c.x r ^ m) {j : ℕ} (hj : j ≤ m) {f : R} (hf : f ∈ I) :
    (⇑(c.chartDerivRing r h))^[j] (transformElem c.x r f (hI hf)) ∈
      transformIdeal c.x r (c.Dpow j I) (m - j) := by
  obtain ⟨hf', heq⟩ := c.iterate_chartDerivRing_transformElem r hh (hI hf) hj
  rw [heq]
  exact transformElem_mem_transformIdeal c.x r (c.iterate_pderiv_mem_Dpow h hf j) hf'

end RegularCoords

end IsLocalRing
