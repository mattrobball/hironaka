module

public import Mathlib.AlgebraicGeometry.Noetherian
public import Hironaka.Scheme.BlowUp.Invertible
public import Hironaka.Scheme.IdealSheaf.Defs
import Hironaka.Scheme.BlowUp.InvertibleSheaf
import Hironaka.Scheme.IdealSheaf.StalkIdeal

/-!
# Invertibility of an ideal sheaf read at the stalks

An ideal sheaf `J` on a scheme is invertible (`IdealSheafData.IsInvertible`, an effective Cartier
divisor [Sta, Tag 01WS]) when near every point it is generated on an affine open by a
nonzerodivisor. This module relates that definition to the stalks.

* `IsInvertible.exists_ne_zero_stalkIdeal_eq_span`: the stalk of an invertible ideal sheaf is
  generated by a nonzero element (the germ of the local nonzerodivisor generator is nonzero in the
  localization); the nonzerodivisor form is
  `IsInvertible.exists_mem_nonZeroDivisors_stalkIdeal_eq_span` of
  `Hironaka/Scheme/IdealSheaf/StalkIdeal.lean`. A nonzero generator is what the order computations
  along a blow-up sequence use.
* `isInvertible_of_forall_stalkIdeal_eq_span`, `isInvertible_iff_forall_stalkIdeal_eq_span`: on a
  locally Noetherian scheme the converse holds, so invertibility *is* the stalkwise condition
  "every stalk is generated by a nonzerodivisor of `𝒪_{X,x}`" (the standing assumption of
  Hironaka's Definition 2 [Hir64, Ch. 0, §5, Definition 2]; [Kol07, Warning 20]). This is the
  form in which the invertibility of a centre or of a reduced snc divisor is checked. The argument
  is routine commutative algebra, not stated as such in the sources.

**Spreading out a generator.** Let `A` be a Noetherian ring, `J ⊆ A` an ideal, `p` a prime,
`S = A_p`, and `a ∈ J` with `J S = (a)` and `a` a nonzerodivisor of `S`. For each of the finitely
many generators `g` of `J` we have `g/1 ∈ (a/1)`, so `s_g g ∈ (a)` for some `s_g ∉ p`
(`Ideal.exists_mul_mem_span_of_mem_map`); the annihilator of `a` is finitely generated and each of
its generators dies in `S`, so it is killed by some `s' ∉ p`
(`Ideal.exists_mul_eq_zero_of_mem_nonZeroDivisors`). On `A_s` with `s = s' ∏ s_g` the ideal `J A_s`
is `(a)` (each `g` is a unit multiple of an element of `(a)`) and `a` is a nonzerodivisor (a
relation `z a = 0` in `A_s` lifts to `y a = 0` up to a power of `s`, so `y` lies in the
annihilator, so `s' y = 0` and `z = 0`): that is the datum `IsRegularGeneratorIn (Localization.Away
s) a` (`Ideal.exists_isRegularGeneratorIn_away`).

**On a scheme.** For a locally Noetherian `X` and an ideal sheaf `J` whose stalk at every point is
generated by a nonzerodivisor, every affine open `U` and prime `p` of `Γ(U)` give the point
`x = fromSpec p ∈ U`, whose stalk is the localization of `Γ(U)` at `p` (Mathlib's
`IsAffineOpen.isLocalization_stalk'`) and whose stalk ideal is the extension of `J(U)`; a generator
`a` of the stalk ideal is a unit multiple of the image of an element of `J(U)`, and the ring lemma
gives the datum at `p`. Hence `J(U)` is invertible for every affine `U`, i.e. `J` is invertible.
-/

public section

universe u v

open AlgebraicGeometry CategoryTheory TopologicalSpace

namespace Ideal

variable {A : Type u} [CommRing A] (p : Ideal A) [p.IsPrime] (S : Type v) [CommRing S]
  [Algebra A S] [IsLocalization.AtPrime S p]

/-- Spreading a generator: if `g/1 ∈ (a/1)` in the localization at `p`, then `s g ∈ (a)` for some
`s ∉ p`. -/
theorem exists_mul_mem_span_of_mem_map {a g : A}
    (hg : algebraMap A S g ∈ Ideal.span {algebraMap A S a}) :
    ∃ s ∉ p, s * g ∈ Ideal.span {a} := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hg
  obtain ⟨⟨b, t⟩, hbt⟩ := IsLocalization.surj p.primeCompl c
  have h1 : algebraMap A S ((t : A) * g) = algebraMap A S (b * a) := by
    rw [map_mul, map_mul, ← hc, ← hbt]
    ring
  obtain ⟨u, hu⟩ := IsLocalization.exists_of_eq (M := p.primeCompl) h1
  refine ⟨(u : A) * t, p.primeCompl.mul_mem u.2 t.2, ?_⟩
  rw [mul_assoc, hu]
  exact Ideal.mem_span_singleton'.mpr ⟨(u : A) * b, by rw [mul_assoc]⟩

/-- Spreading a nonzerodivisor: if `a/1` is a nonzerodivisor of the localization at `p` and `A` is
Noetherian, some `s ∉ p` kills the annihilator of `a`. -/
theorem exists_mul_eq_zero_of_mem_nonZeroDivisors [IsNoetherianRing A] {a : A}
    (ha : algebraMap A S a ∈ nonZeroDivisors S) :
    ∃ s ∉ p, ∀ c : A, c * a = 0 → s * c = 0 := by
  classical
  have hK : ∀ c : A, c ∈ (⊥ : Ideal A).colon {a} ↔ c * a = 0 := fun c => by
    rw [Submodule.mem_colon_singleton, smul_eq_mul, Ideal.mem_bot]
  obtain ⟨C, hC⟩ := (IsNoetherian.noetherian ((⊥ : Ideal A).colon {a}) : _)
  have hmem : ∀ c ∈ C, ∃ v : p.primeCompl, (v : A) * c = 0 := by
    intro c hc
    have hca : c * a = 0 := (hK c).mp (hC ▸ (Ideal.subset_span hc : c ∈ Ideal.span (C : Set A)))
    have h0 : algebraMap A S c = 0 :=
      (mem_nonZeroDivisors_iff_right.mp ha) _ (by rw [← map_mul, hca, map_zero])
    exact (IsLocalization.map_eq_zero_iff p.primeCompl S c).mp h0
  choose! v hv using hmem
  refine ⟨∏ c ∈ C, (v c : A), p.primeCompl.prod_mem fun c _ => (v c).2, fun c hca => ?_⟩
  have hcK : c ∈ Submodule.span A (C : Set A) := by rw [hC]; exact (hK c).mpr hca
  have hkill : Ideal.span (C : Set A) ≤ (⊥ : Ideal A).colon {∏ c ∈ C, (v c : A)} := by
    refine Ideal.span_le.mpr fun c' hc' => ?_
    rw [SetLike.mem_coe, Submodule.mem_colon_singleton, smul_eq_mul, Ideal.mem_bot,
      ← Finset.mul_prod_erase C _ hc']
    calc c' * ((v c' : A) * ∏ x ∈ C.erase c', (v x : A))
        = (∏ x ∈ C.erase c', (v x : A)) * ((v c' : A) * c') := by ring
      _ = 0 := by rw [hv c' hc', mul_zero]
  have := hkill hcK
  rwa [Submodule.mem_colon_singleton, smul_eq_mul, Ideal.mem_bot, mul_comm] at this

/-- The datum `IsRegularGeneratorIn` at a prime, from the localization at that prime: if `a ∈ J`
generates `J A_p` and is a nonzerodivisor of `A_p`, then for some `s ∉ p` it generates `J A_s` and
is a nonzerodivisor of `A_s`. -/
theorem exists_isRegularGeneratorIn_away [IsNoetherianRing A] (J : Ideal A) {a : A} (haJ : a ∈ J)
    (hmap : J.map (algebraMap A S) = Ideal.span {algebraMap A S a})
    (hnzd : algebraMap A S a ∈ nonZeroDivisors S) :
    ∃ s ∉ p, J.IsRegularGeneratorIn (Localization.Away s) a := by
  classical
  obtain ⟨G, hG⟩ := (IsNoetherian.noetherian J : J.FG)
  have hgen : ∀ g ∈ G, ∃ s ∉ p, s * g ∈ Ideal.span {a} := fun g hg =>
    exists_mul_mem_span_of_mem_map p S (by
      rw [← hmap]; exact Ideal.mem_map_of_mem _ (hG ▸ Ideal.subset_span hg))
  choose! sg hsg hsg' using hgen
  obtain ⟨s', hs', hs'0⟩ := exists_mul_eq_zero_of_mem_nonZeroDivisors p S hnzd
  have hsp : s' * ∏ g ∈ G, sg g ∉ p := by
    intro h
    rcases (Ideal.IsPrime.mem_or_mem inferInstance h) with h | h
    · exact hs' h
    · obtain ⟨g, hg, hgp⟩ := Ideal.IsPrime.prod_mem_iff.mp h
      exact hsg g hg hgp
  refine ⟨s' * ∏ g ∈ G, sg g, hsp, ?_, ?_⟩
  · -- `J A_s = (a/1)`
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap, ← hG, Ideal.span_le]
      intro g hg
      rw [SetLike.mem_coe, Ideal.mem_comap]
      have hunit : IsUnit (algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) (sg g)) := by
        obtain ⟨r, hr⟩ : sg g ∣ s' * ∏ g ∈ G, sg g := (Finset.dvd_prod_of_mem _ hg).mul_left _
        have hu : IsUnit (algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g))
            (s' * ∏ g ∈ G, sg g)) :=
          IsLocalization.map_units _ (⟨_, Submonoid.mem_powers _⟩ : Submonoid.powers _)
        have hu' : IsUnit (algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) (sg g) *
            algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) r) := by
          rw [← map_mul, ← hr]; exact hu
        exact isUnit_of_mul_isUnit_left hu'
      have hmem : algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) (sg g) *
          algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) g ∈
          Ideal.span {algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) a} := by
        obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp (hsg' g hg)
        rw [← map_mul, ← hr, map_mul]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      obtain ⟨w, hw⟩ := hunit.exists_left_inv
      have : algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) g =
          w * (algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) (sg g) *
            algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) g) := by
        rw [← mul_assoc, hw, one_mul]
      rw [this]
      exact Ideal.mul_mem_left _ _ hmem
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
      exact Ideal.mem_map_of_mem _ haJ
  · -- `a/1` is a nonzerodivisor of `A_s`
    rw [mem_nonZeroDivisors_iff_right]
    intro z hz
    obtain ⟨⟨y, w⟩, hyw⟩ := IsLocalization.surj (Submonoid.powers (s' * ∏ g ∈ G, sg g)) z
    have h1 : algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) (y * a) = 0 := by
      rw [map_mul, ← hyw, mul_right_comm, hz, zero_mul]
    obtain ⟨⟨_, l, rfl⟩, hl⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers (s' * ∏ g ∈ G, sg g)) _ _).mp h1
    have hann : ((s' * ∏ g ∈ G, sg g) ^ l * y) * a = 0 := by rw [mul_assoc]; exact hl
    have hkill := hs'0 _ hann
    have h2 : algebraMap A (Localization.Away (s' * ∏ g ∈ G, sg g)) y = 0 := by
      rw [IsLocalization.map_eq_zero_iff (Submonoid.powers (s' * ∏ g ∈ G, sg g))]
      refine ⟨⟨(s' * ∏ g ∈ G, sg g) ^ (l + 1), l + 1, rfl⟩, ?_⟩
      change (s' * ∏ g ∈ G, sg g) ^ (l + 1) * y = 0
      calc (s' * ∏ g ∈ G, sg g) ^ (l + 1) * y
          = (∏ g ∈ G, sg g) * (s' * ((s' * ∏ g ∈ G, sg g) ^ l * y)) := by ring
        _ = 0 := by rw [hkill, mul_zero]
    rw [h2] at hyw
    exact ((IsLocalization.map_units _ w).mul_left_eq_zero).mp hyw

end Ideal

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- The stalk of an invertible ideal sheaf is principal with a nonzero generator — the germ of a
local nonzerodivisor generator is nonzero in the localization: if `f/1 = 0` in the stalk then
`s f = 0` for some `s` outside the prime of the point, so `s = 0`, contradicting `s ∉ 𝔭`. -/
theorem IsInvertible.exists_ne_zero_stalkIdeal_eq_span {K : X.IdealSheafData}
    (hK : K.IsInvertible) (x : X) :
    ∃ g : X.presheaf.stalk x, g ≠ 0 ∧ K.stalkIdeal x = Ideal.span {g} := by
  obtain ⟨U, hxU, f, hf, hKU⟩ := hK x
  have hU : IsAffineOpen U.1 := U.2
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxU⟩ : U.1)
  have hloc := hU.isLocalization_stalk ⟨x, hxU⟩
  refine ⟨X.presheaf.germ U.1 x hxU f, ?_, ?_⟩
  · intro h0
    have h0' : algebraMap Γ(X, U) (X.presheaf.stalk x) f = 0 := h0
    rw [IsLocalization.map_eq_zero_iff (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl] at h0'
    obtain ⟨⟨s, hs⟩, hsf⟩ := h0'
    have hs0 : s = 0 := (mem_nonZeroDivisors_iff.mp hf).2 s hsf
    apply hs
    rw [hs0]
    exact Ideal.zero_mem _
  · rw [stalkIdeal_eq_map_germ K U hxU, hKU, Ideal.map_span, Set.image_singleton]

/-- On a locally Noetherian scheme an ideal sheaf whose stalk at every point is generated by a
nonzerodivisor is invertible (an effective Cartier divisor, [Sta, Tag 01WS]; the center of a
trivial blow-up, [Kol07, Warning 20]): on every affine open the ideal is invertible, the datum at
each prime coming from the stalk at the corresponding point by spreading out. -/
theorem isInvertible_of_forall_stalkIdeal_eq_span [IsLocallyNoetherian X] (J : X.IdealSheafData)
    (h : ∀ x : X, ∃ a ∈ nonZeroDivisors (X.presheaf.stalk x), J.stalkIdeal x = Ideal.span {a}) :
    J.IsInvertible := by
  rw [isInvertible_iff_forall_ideal]
  intro U p
  have hnoeth : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian U
  have hU : IsAffineOpen U.1 := U.2
  have hx : hU.fromSpec p ∈ U.1 := by
    have : hU.fromSpec p ∈ Set.range hU.fromSpec := Set.mem_range_self _
    rwa [hU.range_fromSpec] at this
  let _ := X.presheaf.algebra_section_stalk ⟨hU.fromSpec p, hx⟩
  have hloc : IsLocalization p.asIdeal.primeCompl (X.presheaf.stalk (hU.fromSpec p)) :=
    hU.isLocalization_stalk' p hx
  obtain ⟨a, ha, haJ⟩ := h (hU.fromSpec p)
  have hst : J.stalkIdeal (hU.fromSpec p) =
      (J.ideal U).map (algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p))) :=
    stalkIdeal_eq_map_germ J U hx
  obtain ⟨⟨b, t⟩, hbt⟩ := IsLocalization.surj p.asIdeal.primeCompl a
  have hb : algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p)) b ∈
      (J.ideal U).map (algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p))) := by
    rw [← hst, ← hbt, haJ]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self a)
  obtain ⟨⟨j, t'⟩, hjt'⟩ := (IsLocalization.mem_map_algebraMap_iff p.asIdeal.primeCompl _).mp hb
  have hj : algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p)) (j : Γ(X, U)) =
      a * (algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p)) (t : Γ(X, U)) *
        algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p)) (t' : Γ(X, U))) := by
    rw [← hjt', ← hbt, mul_assoc]
  have hunit : IsUnit (algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p)) (t : Γ(X, U)) *
      algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p)) (t' : Γ(X, U))) :=
    (IsLocalization.map_units _ t).mul (IsLocalization.map_units _ t')
  have hmap : (J.ideal U).map (algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p))) =
      Ideal.span {algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p)) (j : Γ(X, U))} := by
    rw [← hst, haJ, hj, Ideal.span_singleton_mul_right_unit hunit]
  have hnzd : algebraMap Γ(X, U) (X.presheaf.stalk (hU.fromSpec p)) (j : Γ(X, U)) ∈
      nonZeroDivisors (X.presheaf.stalk (hU.fromSpec p)) := by
    rw [hj]
    exact mul_mem ha hunit.mem_nonZeroDivisors
  obtain ⟨s, hs, hreg⟩ :=
    Ideal.exists_isRegularGeneratorIn_away p.asIdeal _ (J.ideal U) j.2 hmap hnzd
  exact ⟨s, hs, j, j.2, hreg⟩

/-- On a locally Noetherian scheme, invertibility of an ideal sheaf is the stalkwise condition:
every stalk is generated by a nonzerodivisor of the local ring (the standing assumption of
Hironaka's Definition 2 [Hir64, Ch. 0, §5, Definition 2]). -/
theorem isInvertible_iff_forall_stalkIdeal_eq_span [IsLocallyNoetherian X]
    (J : X.IdealSheafData) :
    J.IsInvertible ↔
      ∀ x : X, ∃ a ∈ nonZeroDivisors (X.presheaf.stalk x), J.stalkIdeal x = Ideal.span {a} :=
  ⟨fun h x => h.exists_mem_nonZeroDivisors_stalkIdeal_eq_span x,
    isInvertible_of_forall_stalkIdeal_eq_span J⟩

end AlgebraicGeometry.Scheme.IdealSheafData
