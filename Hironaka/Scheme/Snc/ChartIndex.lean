/-!
# The chart of a point of the exceptional divisor

[Hau14, Proposition 5.4 (5)–(7)] at a point `a'` of the exceptional divisor `F` over `a`, in
coordinates `z` at `a` with `I_{Z,a} = (z_l : l ∈ s)`, stated on the stalk `𝒪_{B,a'}` through
`π^* : 𝒪_{X,a} → 𝒪_{B,a'}` as in `Hironaka.Scheme.Snc.TotalTransformOnCentre`.

**(5), the chart index.** The exceptional ideal at `a'` is `F_{a'} = I_{Z,a} · 𝒪_{B,a'}`, generated
by the `π^* z_l`, `l ∈ s`; it is principal and nonzero (`F_{a'} = (z'_j)` for a regular system of
parameters `z'` at `a'`, `TotalTransformData`). In a local domain a nonzero principal ideal
generated by finitely many elements is generated by one of them
(`exists_span_singleton_eq_of_span_range_eq`: writing `e = ∑ c_l g_l` and `g_l = d_l e` gives
`∑ c_l d_l = 1`, so some `c_l d_l` is a unit and `(g_l) = (e)`). Hence `F_{a'} = (π^* z_j)` for some
`j ∈ s` — "`a'` lies in the `x_j`-chart" — and every `π^* z_l`, `l ∈ s`, is a multiple
`y_l · π^* z_j` (`exists_chart_index`): Hauser's chart expression `x_l ↦ x_l x_j`. Where `a'` lies
on the strict transform of a component `E^i = (z_c = 0)` through `Z`, the chart index is not `c`
(`ne_of_mem_support_strictTransformAlong`): this is the clause on the strict transform of `V` in
[Hau14, Proposition 5.4 (9)].

**(6)–(7), the strict transforms in the induced coordinates.** For a component `E^i = (z_c = 0)`
containing `Z` near `a` (`c ∈ s`) with `π^* z_c = y · π^* z_j`, the chart computation gives
`π^* z_c = u · π^* z_j` with the strict transform of `E^i` equal to `(u)` at `a'`; cancelling the
nonzero `π^* z_j` in the domain `𝒪_{B,a'}` gives `u = y`, so the strict transform is `(y)`
(`stalkIdeal_strictTransformAlong_eq_span_of_eq_mul`; Hauser's (7) for `V = (z_{n-k+1} = 0)`) and it
passes through `a'` exactly when `y ∈ 𝔪_{a'}` — the entry of `a'` at the coordinate `y` is zero
(`mem_maximalIdeal_iff_mem_support_strictTransformAlong`; Hauser's (6)).

Sources: [Hau14, Proposition 5.4 (5)–(7); Definition 6.2],
[Hau03, Appendix C (5), (7) and its proof], [Kol07, Definition 60].
-/

public section

universe u

open AlgebraicGeometry CategoryTheory IsLocalRing Ideal Scheme.IdealSheafData _root_.Algebra

namespace AlgebraicGeometry

section LocalDomain

variable {R : Type*} [CommRing R] [IsLocalRing R] [IsDomain R]

/-- In a local domain, a nonzero principal ideal generated by finitely many elements is generated
by one of them. -/
theorem exists_span_singleton_eq_of_span_range_eq {ι : Type*} [Finite ι] (g : ι → R) {e : R}
    (he : e ≠ 0) (h : span (Set.range g) = span {e}) : ∃ i, span {g i} = span {e} := by
  classical
  cases nonempty_fintype ι
  have hmem : e ∈ span (Set.range g) := h ▸ subset_span rfl
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  have hg : ∀ i, ∃ d : R, d * e = g i := fun i =>
    Ideal.mem_span_singleton'.mp (h ▸ subset_span ⟨i, rfl⟩)
  choose d hd using hg
  have hsum : (∑ i, c i * d i) = 1 := by
    have h1 : (∑ i, c i * d i) * e = 1 * e := by
      rw [one_mul, Finset.sum_mul]
      calc ∑ i, c i * d i * e = ∑ i, c i * g i :=
            Finset.sum_congr rfl fun i _ => by rw [mul_assoc, hd i]
        _ = e := hc
    exact mul_right_cancel₀ he h1
  by_contra hno
  have hall : ∀ i, c i * d i ∈ maximalIdeal R := by
    intro i
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact hno ⟨i, by
      rw [← hd i, Ideal.span_singleton_mul_left_unit (isUnit_of_mul_isUnit_right hu)]⟩
  have h1 : (1 : R) ∈ maximalIdeal R := hsum ▸ Ideal.sum_mem _ fun i _ => hall i
  exact (Ideal.ne_top_iff_one _).mp (maximalIdeal.isMaximal R).ne_top h1

end LocalDomain

variable {k : Type u} [Field k] {X : Scheme.{u}}

section Chart

variable [PerfectField k] (f : X ⟶ Spec (.of k)) [Smooth f] {ι : Type*} [Finite ι]
  (E : ι → X.IdealSheafData) (Z : X.IdealSheafData)
  (hZ : ∀ x ∈ Z.support, ∃ (n : ℕ) (z : Fin n → X.presheaf.stalk x),
    (span (Set.range z) = maximalIdeal (X.presheaf.stalk x) ∧
      (n : WithBot ℕ∞) = ringKrullDim (X.presheaf.stalk x)) ∧
    (∃ c : {i : ι // x ∈ (E i).support} → Fin n, Function.Injective c ∧
      ∀ i, (E i.1).stalkIdeal x = span {z (c i)}) ∧
    ∃ s : Finset (Fin n), Z.stalkIdeal x = span (z '' ↑s))
  (x' : blowUp Z) (hx' : x' ∈ (Z.comap (blowUpπ Z)).support) {n : ℕ}
  {z : Fin n → X.presheaf.stalk (blowUpπ Z x')}
  (hz : span (Set.range z) = maximalIdeal (X.presheaf.stalk (blowUpπ Z x')) ∧
    (n : WithBot ℕ∞) = ringKrullDim (X.presheaf.stalk (blowUpπ Z x')))
  {s : Finset (Fin n)} (hs : Z.stalkIdeal (blowUpπ Z x') = span (z '' ↑s))

omit [Finite ι] in
/-- The clause on the strict transform: where `x'` lies on the strict transform of a component
`E^i = (z_c = 0)`, the chart index `j` (with `F_{x'} = (π^* z_j)`) is not `c`. -/
theorem ne_of_mem_support_strictTransformAlong {i : ι} {c : Fin n}
    (hc : (E i).stalkIdeal (blowUpπ Z x') = span {z c}) {j : Fin n}
    (hF : (Z.comap (blowUpπ Z)).stalkIdeal x' = span {(blowUpπ Z).stalkMap x' (z j)})
    (hmem : x' ∈ ((E i).strictTransformAlong (blowUpπ Z) (Z.comap (blowUpπ Z))).support) :
    j ≠ c := by
  rintro rfl
  exact notMem_support_strictTransformAlong_of_stalkIdeal_eq Z (E i) x' hc hF hmem

include f hZ hx'

/-- The exceptional ideal at a point `x'` of the exceptional divisor is nonzero: it is generated by
a member of a regular system of parameters (`TotalTransformData`). -/
theorem stalkIdeal_comap_π_ne_bot : (Z.comap (blowUpπ Z)).stalkIdeal x' ≠ ⊥ := by
  obtain ⟨hreg, m, z', hz', j, a, hF, -⟩ :=
    (exists_totalTransformData_of_mem_support f E Z hZ x' hx').1
  rw [hF]
  intro h0
  rw [Ideal.span_singleton_eq_bot] at h0
  exact notMem_sq_of_span_eq z' hz'.1.symm hz'.2 j (h0 ▸ Ideal.zero_mem _)

include hz hs

omit hz in
/-- [Hau14, Proposition 5.4 (5)]: a point `x'` of the exceptional divisor over `x` lies in the chart
of one of the coordinates `z_j`, `j ∈ s`, cutting out the centre — `F_{x'} = (π^* z_j)` — and there
every `π^* z_l`, `l ∈ s`, is a multiple of `π^* z_j`: the chart expression `x_l ↦ x_l x_j` of the
blow-up. -/
theorem exists_chart_index :
    ∃ j ∈ s, (Z.comap (blowUpπ Z)).stalkIdeal x' = span {(blowUpπ Z).stalkMap x' (z j)} ∧
      ∀ l ∈ s, ∃ y : (blowUp Z).presheaf.stalk x',
        (blowUpπ Z).stalkMap x' (z l) = y * (blowUpπ Z).stalkMap x' (z j) := by
  have hreg : IsRegularLocalRing ((blowUp Z).presheaf.stalk x') :=
    (exists_totalTransformData_of_mem_support f E Z hZ x' hx').1.1
  obtain ⟨-, m, z', hz', j', a, hF, -⟩ :=
    (exists_totalTransformData_of_mem_support f E Z hZ x' hx').1
  have hne : z' j' ≠ 0 := fun h0 =>
    notMem_sq_of_span_eq z' hz'.1.symm hz'.2 j' (h0 ▸ Ideal.zero_mem _)
  -- the exceptional ideal is generated by the `π^* z_l`, `l ∈ s`
  have hgen : span (Set.range fun l : s => (blowUpπ Z).stalkMap x' (z l.1)) = span {z' j'} := by
    rw [← hF, stalkIdeal_comap, hs, Ideal.map_span, Set.image_image]
    congr 1
    ext w
    constructor
    · rintro ⟨l, rfl⟩
      exact ⟨l.1, l.2, rfl⟩
    · rintro ⟨l, hl, rfl⟩
      exact ⟨⟨l, hl⟩, rfl⟩
  obtain ⟨⟨j, hj⟩, hjF⟩ := exists_span_singleton_eq_of_span_range_eq _ hne hgen
  refine ⟨j, hj, hF.trans hjF.symm, fun l hl => ?_⟩
  have hmem : (blowUpπ Z).stalkMap x' (z l) ∈ span {(blowUpπ Z).stalkMap x' (z j)} := by
    rw [hjF, ← hgen]
    exact subset_span ⟨⟨l, hl⟩, rfl⟩
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hmem
  exact ⟨y, hy.symm⟩

/-- [Hau14, Proposition 5.4 (7)]: for a component `E^i = (z_c = 0)` containing `Z` near `x`
(`c ∈ s`), in the chart of `z_j` with `π^* z_c = y · π^* z_j`, the strict transform of `E^i` at `x'`
is `(y)` — for `V = (z_{n-k+1} = 0)`, "`V^s` is given in the induced coordinates by
`x_{n-k+1} = 0`". -/
theorem stalkIdeal_strictTransformAlong_eq_span_of_eq_mul {i : ι} {c : Fin n}
    (hc : (E i).stalkIdeal (blowUpπ Z x') = span {z c}) (hcs : c ∈ s) {j : Fin n}
    (hF : (Z.comap (blowUpπ Z)).stalkIdeal x' = span {(blowUpπ Z).stalkMap x' (z j)})
    {y : (blowUp Z).presheaf.stalk x'}
    (hy : (blowUpπ Z).stalkMap x' (z c) = y * (blowUpπ Z).stalkMap x' (z j)) :
    ((E i).strictTransformAlong (blowUpπ Z) (Z.comap (blowUpπ Z))).stalkIdeal x' = span {y} := by
  have hreg : IsRegularLocalRing ((blowUp Z).presheaf.stalk x') :=
    (exists_totalTransformData_of_mem_support f E Z hZ x' hx').1.1
  obtain ⟨u, hu, hstrict⟩ :=
    exists_stalkIdeal_strictTransformAlong_eq_span_of_mem f E Z hZ i x' hx' hz hs hc hcs hF
  have hne : (blowUpπ Z).stalkMap x' (z j) ≠ 0 := by
    intro h0
    apply stalkIdeal_comap_π_ne_bot f E Z hZ x' hx'
    rw [hF, h0, Ideal.span_singleton_eq_bot]
  have huy : u = y := mul_right_cancel₀ hne (hu.symm.trans hy)
  rw [hstrict, huy]

/-- [Hau14, Proposition 5.4 (6)]: the entry `y` of `x'` at the coordinate of a component
`E^i = (z_c = 0)` containing `Z` near `x` (`π^* z_c = y · π^* z_j`) vanishes at `x'` exactly when
the strict transform of `E^i` passes through `x'`. -/
theorem mem_maximalIdeal_iff_mem_support_strictTransformAlong {i : ι} {c : Fin n}
    (hc : (E i).stalkIdeal (blowUpπ Z x') = span {z c}) (hcs : c ∈ s) {j : Fin n}
    (hF : (Z.comap (blowUpπ Z)).stalkIdeal x' = span {(blowUpπ Z).stalkMap x' (z j)})
    {y : (blowUp Z).presheaf.stalk x'}
    (hy : (blowUpπ Z).stalkMap x' (z c) = y * (blowUpπ Z).stalkMap x' (z j)) :
    y ∈ maximalIdeal ((blowUp Z).presheaf.stalk x') ↔
      x' ∈ ((E i).strictTransformAlong (blowUpπ Z) (Z.comap (blowUpπ Z))).support := by
  rw [mem_support_iff_stalkIdeal_le_maximalIdeal,
    stalkIdeal_strictTransformAlong_eq_span_of_eq_mul f E Z hZ x' hx' hz hs hc hcs hF hy,
    Ideal.span_singleton_le_iff_mem]

end Chart

end AlgebraicGeometry
