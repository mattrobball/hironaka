module

public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import Hironaka.Scheme.IdealSheaf.Defs
public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
import Hironaka.Scheme.BlowUp.InvertibleSheaf
import Hironaka.Scheme.IdealSheaf.StalkIdeal

/-!
# Descent of closed subschemes along flat morphisms

A blow-up sequence pulled back along a surjective smooth morphism determines the original
sequence [Kol07, Definition 30, 30.1], and in the proof that maximal contact hypersurfaces give
the same blow-up sequence, the centres over a common étale cover are compared through their
inverse images [Kol07, Theorem 97, proof].  The two descent lemmas behind these sentences are
stated here for ideal sheaves and proved stalkwise, without scheme-theoretic images:

* (a) for `f : U ⟶ X` flat and closed subschemes `Z, Z' ⊆ X` whose supports lie in the image of
  `f`, `f⁻¹Z = f⁻¹Z'` implies `Z = Z'` (`IdealSheafData.eq_of_comap_eq_of_flat`);
* (b) for `f, g : U ⟶ X` flat, `Z, Z' ⊆ X` closed with `|Z| ⊆ f(U)`, `|Z'| ⊆ g(U)`,
  `f⁻¹Z = g⁻¹Z' =: C` and `f ∘ ι_C = g ∘ ι_C`, one has `Z = Z'`
  (`IdealSheafData.eq_of_comap_eq_of_agreeOn`).

## The argument

*Stalks decide.*  An ideal sheaf is determined by its stalk ideals `J_x ⊆ 𝒪_{X,x}` (the ideal
generated by the germs of `J`, `IdealSheafData.stalkIdeal`): on an affine open `U`, the stalk at
the point of a maximal ideal `𝔪` of `Γ(U)` is the localization `Γ(U)_𝔪`, and an ideal of `Γ(U)`
is determined by its localizations at the maximal ideals (Mathlib's
`Ideal.le_of_localization_maximal`).  This is `IdealSheafData.le_of_stalkIdeal_le` and
`ext_stalkIdeal`, extensionality by stalks.  Off the support the stalk ideal is the unit ideal
(`stalkIdeal_eq_top_of_notMem_support`: some section of `J` is a unit at `x`).

*Contraction.*  For flat `f` the stalk map `𝒪_{X, f u} → 𝒪_{U, u}` is a flat local
homomorphism of local rings, hence faithfully flat (Mathlib's
`Module.FaithfullyFlat.of_flat_of_isLocalHom`), so every ideal `K` of the source is recovered from
its extension: `comap (map K) = K` (`Ideal.comap_map_eq_self_of_faithfullyFlat`;
`comap_stalkMap_map_eq_self`).  The stalk of `Z.comap f` at `u` is the extension of the stalk of
`Z` at `f u` (`stalkIdeal_comap`).

*(a).*  At `x = f u`: `Z_x = comap (map Z_x) = comap ((Z.comap f)_u) = comap ((Z'.comap f)_u) =
Z'_x`; at `x ∉ f(U)`, `x` lies in neither support and both stalk ideals are the unit ideal.

*(b).*  `g ∘ ι_C` factors through `Z'` — `Z'.comap (ι_C ≫ g) = C.comap ι_C = ⊥` — hence so does
`f ∘ ι_C`, i.e. `(Z'.comap f).comap ι_C = ⊥`, which says `Z'.comap f ≤ C = Z.comap f`
(Mathlib's Galois connection `le_map_iff_comap_le` with `ι_C.ker = C`).  Contract stalkwise along
`f` at the points of `|Z|` (`le_of_comap_le_of_flat`): `Z'_x ≤ comap (map Z'_x) ≤ comap (map Z_x)
= Z_x`; off `|Z|` the right side is the unit ideal.  So `Z' ≤ Z`, and by symmetry (contract along
`g` at the points of `|Z'|`) `Z ≤ Z'`.

Nothing here assumes `X`, `U` Noetherian, `f` quasi-compact or surjective onto more than the
supports; in the application to maximal contact, `f` is étale with open image and the supports
of the centres lie in it.
-/

public section

namespace AlgebraicGeometry.Scheme.IdealSheafData

open CategoryTheory TopologicalSpace

universe u

variable {X U : Scheme.{u}}

section StalkExt

/-- Off the support the stalk ideal is the unit ideal: some section of `J` over an affine
neighbourhood is a unit at `x` (Mathlib's `mem_zeroLocus_iff`, `mem_basicOpen`). -/
theorem stalkIdeal_eq_top_of_notMem_support (J : X.IdealSheafData) {x : X}
    (hx : x ∉ J.support) : J.stalkIdeal x = ⊤ := by
  obtain ⟨V, hxV⟩ := exists_affineOpens_mem x
  rw [mem_support_iff_of_mem hxV, mem_zeroLocus_iff] at hx
  push Not at hx
  obtain ⟨s, hs, hxs⟩ := hx
  rw [stalkIdeal_eq_map_germ J V hxV]
  exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hs)
    ((Scheme.mem_basicOpen X s x hxV).mp hxs)

/-- Monotonicity of the stalk ideal. -/
theorem stalkIdeal_mono {I J : X.IdealSheafData} (h : I ≤ J) (x : X) :
    I.stalkIdeal x ≤ J.stalkIdeal x := by
  obtain ⟨V, hxV⟩ := exists_affineOpens_mem x
  rw [stalkIdeal_eq_map_germ I V hxV, stalkIdeal_eq_map_germ J V hxV]
  exact Ideal.map_mono (ideal_mono h V)

/-- An ideal sheaf is bounded by another as soon as its stalk ideals are: on an affine open `V`
the stalk at the point of a maximal ideal `𝔪` of `Γ(V)` is the localization at `𝔪`, and an ideal
is determined by its localizations at the maximal ideals (`Ideal.le_of_localization_maximal`). -/
theorem le_of_stalkIdeal_le {I J : X.IdealSheafData} (h : ∀ x, I.stalkIdeal x ≤ J.stalkIdeal x) :
    I ≤ J := by
  refine le_of_iSup_eq_top (fun V : X.affineOpens => V) (iSup_affineOpens_eq_top X) fun V => ?_
  have hV : IsAffineOpen V.1 := V.2
  refine Ideal.le_of_localization_maximal fun P hP => ?_
  have hPp : P.IsPrime := hP.isPrime
  set y : PrimeSpectrum Γ(X, V) := ⟨P, hPp⟩ with hy
  have hxV : hV.fromSpec y ∈ V.1 := by
    rw [← SetLike.mem_coe, ← hV.range_fromSpec]
    exact Set.mem_range_self y
  set x := hV.fromSpec y with hx
  let _ : Algebra Γ(X, V) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxV⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk x) P := hV.isLocalization_stalk' y hxV
  set e := IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P) (X.presheaf.stalk x)
  set e' : Localization.AtPrime P →+* X.presheaf.stalk x := e.toAlgHom.toRingHom
  have key : ∀ K : Ideal Γ(X, V),
      K.map (algebraMap Γ(X, V) (X.presheaf.stalk x)) =
        (K.map (algebraMap Γ(X, V) (Localization.AtPrime P))).map e' := fun K => by
    rw [Ideal.map_map]
    congr 1
    exact RingHom.ext fun r => (e.commutes r).symm
  have hle := h x
  rw [stalkIdeal_eq_map_germ I V hxV, stalkIdeal_eq_map_germ J V hxV,
    ← TopCat.Presheaf.stalk_open_algebraMap X.presheaf ⟨x, hxV⟩, key, key] at hle
  have := Ideal.comap_mono (f := e') hle
  rwa [Ideal.comap_map_of_bijective e' e.bijective,
    Ideal.comap_map_of_bijective e' e.bijective] at this

/-- Extensionality by stalks: ideal sheaves with equal stalk ideals at every point are equal. -/
theorem ext_stalkIdeal {I J : X.IdealSheafData} (h : ∀ x, I.stalkIdeal x = J.stalkIdeal x) :
    I = J :=
  le_antisymm (le_of_stalkIdeal_le fun x => (h x).le) (le_of_stalkIdeal_le fun x => (h x).ge)

end StalkExt

section Descent

variable (f : U ⟶ X) [Flat f]

/-- For flat `f` the stalk map `𝒪_{X, f u} → 𝒪_{U, u}` is a flat local homomorphism of local
rings, hence faithfully flat (`Module.FaithfullyFlat.of_flat_of_isLocalHom`), so the contraction
of the extension of an ideal `K` of `𝒪_{X, f u}` is `K`
(`Ideal.comap_map_eq_self_of_faithfullyFlat`; [Sta, Tag 00HQ] at the local rings). -/
theorem _root_.AlgebraicGeometry.Scheme.Hom.comap_stalkMap_map_eq_self (u : U)
    (K : Ideal (X.presheaf.stalk (f u))) :
    (K.map (f.stalkMap u).hom).comap (f.stalkMap u).hom = K := by
  have hφ : (f.stalkMap u).hom.Flat := Flat.stalkMap f u
  set φ := (f.stalkMap u).hom with hφ_def
  algebraize [φ]
  have : IsLocalHom (algebraMap (X.presheaf.stalk (f u)) (U.presheaf.stalk u)) :=
    (inferInstance : IsLocalHom φ)
  have : Module.FaithfullyFlat (X.presheaf.stalk (f u)) (U.presheaf.stalk u) :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  exact Ideal.comap_map_eq_self_of_faithfullyFlat K

/-- The stalkwise half of the descent lemma: for `f` flat and `|Z| ⊆ f(U)`, an inequality
`Z'.comap f ≤ Z.comap f` of inverse images descends to `Z' ≤ Z` — contract along the faithfully
flat stalk maps at the points of `|Z|`; off `|Z|` the stalk of `Z` is the unit ideal. -/
theorem le_of_comap_le_of_flat (Z Z' : X.IdealSheafData) (hZ : (Z.support : Set X) ⊆ Set.range f)
    (h : Z'.comap f ≤ Z.comap f) : Z' ≤ Z := by
  refine le_of_stalkIdeal_le fun x => ?_
  by_cases hx : x ∈ Set.range f
  · obtain ⟨u, rfl⟩ := hx
    have hst := stalkIdeal_mono h u
    rw [stalkIdeal_comap, stalkIdeal_comap] at hst
    calc Z'.stalkIdeal (f u)
        ≤ ((Z'.stalkIdeal (f u)).map (f.stalkMap u).hom).comap (f.stalkMap u).hom :=
          Ideal.le_comap_map
      _ ≤ ((Z.stalkIdeal (f u)).map (f.stalkMap u).hom).comap (f.stalkMap u).hom :=
          Ideal.comap_mono hst
      _ = Z.stalkIdeal (f u) := f.comap_stalkMap_map_eq_self u _
  · rw [stalkIdeal_eq_top_of_notMem_support Z fun hm => hx (hZ hm)]
    exact le_top

/-- **A closed subscheme with support in the image of a flat map is determined by its inverse
image** (the pull-back along a surjective smooth morphism determines the blow-up sequence,
[Kol07, Definition 30, 30.1]; [Sta, Tag 00HQ]).  For `f : U ⟶ X` flat and `Z, Z'` with
`|Z| ∪ |Z'| ⊆ f(U)`, `f⁻¹Z = f⁻¹Z'` implies `Z = Z'`. -/
theorem eq_of_comap_eq_of_flat (Z Z' : X.IdealSheafData) (hZ : (Z.support : Set X) ⊆ Set.range f)
    (hZ' : (Z'.support : Set X) ⊆ Set.range f) (h : Z.comap f = Z'.comap f) : Z = Z' :=
  le_antisymm (le_of_comap_le_of_flat f Z' Z hZ' h.le) (le_of_comap_le_of_flat f Z Z' hZ h.ge)

/-- A morphism `ι_C ≫ g` out of the closed subscheme `C = W.comap g` factors through `W`:
`W.comap (ι_C ≫ g) = ⊥`. -/
theorem comap_subschemeι_comp_eq_bot {Y : Scheme.{u}} (W : X.IdealSheafData) (g : Y ⟶ X) :
    W.comap ((W.comap g).subschemeι ≫ g) = ⊥ := by
  rw [comap_comp]
  refine le_bot_iff.mp (le_map_iff_comap_le.mp ?_)
  rw [map_bot, ker_subschemeι]

/-- **Two flat maps agreeing on the common preimage give equal centres** (the comparison of
centres over a common étale cover in the proof of [Kol07, Theorem 97]).  For `f, g : U ⟶ X`
flat, `Z, Z'` with `|Z| ⊆ f(U)`, `|Z'| ⊆ g(U)`, `f⁻¹Z = g⁻¹Z' =: C` and `f ∘ ι_C = g ∘ ι_C`, one
has `Z = Z'`; scheme-theoretic images are not needed. -/
theorem eq_of_comap_eq_of_agreeOn (g : U ⟶ X) [Flat g] (Z Z' : X.IdealSheafData)
    (hZ : (Z.support : Set X) ⊆ Set.range f) (hZ' : (Z'.support : Set X) ⊆ Set.range g)
    (h : Z.comap f = Z'.comap g)
    (hfg : (Z.comap f).subschemeι ≫ f = (Z.comap f).subschemeι ≫ g) : Z = Z' := by
  -- `g ∘ ι_C` factors through `Z'`, hence so does `f ∘ ι_C`: `Z'.comap f ≤ C = Z.comap f`
  have hC : Z'.comap ((Z.comap f).subschemeι ≫ g) = ⊥ := by
    have := comap_subschemeι_comp_eq_bot Z' g
    rw [h]
    exact this
  have h1 : Z'.comap f ≤ Z.comap f := by
    have hW : Z'.comap ((Z.comap f).subschemeι ≫ f) = ⊥ := by
      rw [hfg]
      exact hC
    rw [comap_comp] at hW
    have := le_map_iff_comap_le.mpr hW.le
    rwa [map_bot, ker_subschemeι] at this
  -- symmetrically `f ∘ ι_C` factors through `Z`, hence so does `g ∘ ι_C`:
  -- `Z.comap g ≤ C = Z'.comap g`
  have h2 : Z.comap g ≤ Z'.comap g := by
    have hW : Z.comap ((Z'.comap g).subschemeι ≫ g) = ⊥ := by
      rw [← h, ← hfg]
      exact comap_subschemeι_comp_eq_bot Z f
    rw [comap_comp] at hW
    have := le_map_iff_comap_le.mpr hW.le
    rwa [map_bot, ker_subschemeι] at this
  exact le_antisymm (le_of_comap_le_of_flat g Z' Z hZ' h2) (le_of_comap_le_of_flat f Z Z' hZ h1)

end Descent

end AlgebraicGeometry.Scheme.IdealSheafData
