module

public import Hironaka.Scheme.BlowUp.Rees.Basic
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal

/-!
# The graded Rees algebra is generated in degree one

The Rees algebra of `I` is generated by its elements of degree one [Hau14, Definition 4.6], and
`Proj` of the Rees algebra is covered by the `D₊(a t)`, `a ∈ I`, because these elements generate
the irrelevant ideal [Sta, Tag 0804].  Mathlib has the subalgebra statement
`adjoin_monomial_eq_reesAlgebra`; what `Proj.affineOpenCoverOfIrrelevantLESpan` needs is the
*ideal* statement proved here: the irrelevant ideal `HomogeneousIdeal.irrelevant (grading I)`
(the elements with vanishing degree-zero component) lies in
`Ideal.span (Set.range (reesAlgebra.degreeOne I))`.

## The argument

An element `x` of the Rees algebra is the sum of its homogeneous components
(`DirectSum.sum_support_decompose`); if `x` is in the irrelevant ideal the degree-zero component
is `0`, so it suffices to place every homogeneous element of positive degree in the ideal
generated by degree one.  Such an element is `c tⁿ` with `c ∈ I ^ n` and `n = m + 1`
(`reesAlgebra.eq_monomial_of_mem_grading`); writing `c` as a sum of products `d · a` with
`d ∈ I ^ m`, `a ∈ I` (`Submodule.mul_induction_on'` on `I ^ (m + 1) = I ^ m * I`) gives
`c t^(m+1) = ∑ (d tᵐ) · (a t)`, a combination of the generators `a t` with coefficients in the
Rees algebra (`reesAlgebra.mem_span_degreeOne_of_coe_eq_monomial`).  This is the induction of
Mathlib's `monomial_mem_adjoin_monomial`, run one step.

## Boundary cases

For `I = 0` the irrelevant ideal is `0` and the statement is trivial; for `I = R` the degree-one
elements are the `r t`, and the irrelevant ideal is `(t)`.
-/

public section


open Polynomial

universe u

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- A monomial `c tⁿ` of positive degree `n` with `c ∈ I ^ n` lies in the ideal of the Rees algebra
generated by the degree-one elements `a t`, `a ∈ I` [Hau14, Definition 4.6]. -/
theorem reesAlgebra.mem_span_degreeOne_of_coe_eq_monomial {n : ℕ} (hn : 0 < n) {c : R}
    (hc : c ∈ I ^ n) {p : reesAlgebra I} (hp : (p : R[X]) = monomial n c) :
    p ∈ Ideal.span (Set.range (reesAlgebra.degreeOne I)) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  rw [pow_succ] at hc
  refine Submodule.mul_induction_on' (C := fun c _ => ∀ q : reesAlgebra I,
    (q : R[X]) = monomial (m + 1) c → q ∈ Ideal.span (Set.range (reesAlgebra.degreeOne I)))
    ?_ ?_ hc p hp
  · intro d hd a ha q hq
    have : q = ⟨monomial m d, reesAlgebra.monomial_mem.mpr hd⟩ * reesAlgebra.degreeOne I ⟨a, ha⟩ :=
      Subtype.ext (by rw [hq, Subalgebra.coe_mul, reesAlgebra.coe_degreeOne, monomial_mul_monomial])
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨_, rfl⟩)
  · intro x hx y hy ihx ihy q hq
    have hx' : monomial (m + 1) x ∈ reesAlgebra I :=
      reesAlgebra.monomial_mem.mpr (by rw [pow_succ]; exact hx)
    have hy' : monomial (m + 1) y ∈ reesAlgebra I :=
      reesAlgebra.monomial_mem.mpr (by rw [pow_succ]; exact hy)
    have : q = ⟨monomial (m + 1) x, hx'⟩ + ⟨monomial (m + 1) y, hy'⟩ :=
      Subtype.ext (by rw [hq, Subalgebra.coe_add, map_add])
    rw [this]
    exact Ideal.add_mem _ (ihx _ rfl) (ihy _ rfl)

/-- **Generated in degree one** [Hau14, Definition 4.6]; [Sta, Tag 0804]: the irrelevant ideal of
the graded Rees algebra lies in the ideal generated by the degree-one elements `a t`, `a ∈ I`.
This is the hypothesis of Mathlib's `Proj.affineOpenCoverOfIrrelevantLESpan`, which covers the
affine blow-up by the charts `D₊(a t)` (`affineBlowUp.affineOpenCover`). -/
theorem reesAlgebra.irrelevant_le_span_degreeOne :
    (HomogeneousIdeal.irrelevant (reesAlgebra.grading I)).toIdeal ≤
      Ideal.span (Set.range (reesAlgebra.degreeOne I)) := by
  classical
  intro x hx
  rw [HomogeneousIdeal.toIdeal_irrelevant, RingHom.mem_ker, GradedRing.projZeroRingHom_apply] at hx
  rw [← DirectSum.sum_support_decompose (reesAlgebra.grading I) x]
  refine Ideal.sum_mem _ fun i _ => ?_
  rcases Nat.eq_zero_or_pos i with rfl | hi
  · rw [hx]
    exact Ideal.zero_mem _
  · obtain ⟨heq, hmem⟩ :=
      reesAlgebra.eq_monomial_of_mem_grading (DirectSum.decompose (reesAlgebra.grading I) x i).2
    exact reesAlgebra.mem_span_degreeOne_of_coe_eq_monomial I hi hmem heq

/-- Generation in degree one from any generating set of `I` (for generators `g₁, …, g_k` of `I`
the blow-up is covered by the charts of the `gᵢ` [Hau14, Theorem 4.19]): the irrelevant ideal
lies in the ideal generated by the `x t`, `x ∈ s`, whenever `s` generates `I` — every `a t`,
`a ∈ I`, is an `R`-combination of them, since `a ↦ a t` is `R`-linear.  This covers the affine
blow-up by the charts of a generating set (`affineBlowUp.affineOpenCoverOfSpan`; the empty set
for `I = 0`). -/
theorem reesAlgebra.irrelevant_le_span_degreeOne_of_span_eq (s : Set R) (hs : Ideal.span s = I) :
    (HomogeneousIdeal.irrelevant (reesAlgebra.grading I)).toIdeal ≤
      Ideal.span (Set.range fun x : s =>
        reesAlgebra.degreeOne I ⟨x, hs ▸ Ideal.subset_span x.2⟩) := by
  refine (reesAlgebra.irrelevant_le_span_degreeOne I).trans (Ideal.span_le.mpr ?_)
  rintro _ ⟨a, rfl⟩
  set J := Ideal.span (Set.range fun x : s =>
    reesAlgebra.degreeOne I ⟨x, hs ▸ Ideal.subset_span x.2⟩) with hJ
  have key : ∀ x (hx : x ∈ Ideal.span s), ∀ hx' : x ∈ I,
      reesAlgebra.degreeOne I ⟨x, hx'⟩ ∈ J := by
    intro x hx
    refine Submodule.span_induction
      (p := fun x _ => ∀ hx' : x ∈ I, reesAlgebra.degreeOne I ⟨x, hx'⟩ ∈ J) ?_ ?_ ?_ ?_ hx
    · intro x hxs _
      exact Ideal.subset_span ⟨⟨x, hxs⟩, rfl⟩
    · intro _
      exact (map_zero (reesAlgebra.degreeOne I)).symm ▸ Ideal.zero_mem _
    · intro x y hxs hys ihx ihy _
      have hx' : x ∈ I := hs ▸ hxs
      have hy' : y ∈ I := hs ▸ hys
      exact (map_add (reesAlgebra.degreeOne I) ⟨x, hx'⟩ ⟨y, hy'⟩).symm ▸
        Ideal.add_mem _ (ihx hx') (ihy hy')
    · intro r x hxs ih _
      have hx' : x ∈ I := hs ▸ hxs
      exact (map_smul (reesAlgebra.degreeOne I) r ⟨x, hx'⟩).symm ▸
        Submodule.smul_of_tower_mem _ r (ih hx')
  exact key a (hs ▸ a.2) a.2

