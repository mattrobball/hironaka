/-!
# Coherence of the quotient by an ideal sheaf

If `𝒪_X` is coherent and `𝒥` is an ideal sheaf of finite type, the structure sheaf
`(𝒪_X/𝒥)|_{S(𝒥)}` of the quotient space (`QuotientSpace.quotientSpace`) is coherent
([Fre17, Ch. V, 7.3]). This is how the coherence of the structure sheaf of a closed subspace, and
in particular of a local model, follows from Oka's theorem, as in [BM97, (3.8)(3)].

The proof is the standard reduction of relations modulo `𝒥` to relations in `𝒪_X`. Near a point
`z` of the support, the entries `F i j` of a matrix of sections of the quotient are the classes of
ambient sections `a i j` (the compatible-germ-family definition of the quotient sheaf), and `𝒥` is
generated by sections `g₁, …, g_l`. A vector `c` of classes is a relation of `F` at `w` iff, for
lifts `c̃`, `Σ_j a_{ij} c̃_j ∈ 𝒥_w` for every row `i`, i.e. iff `c̃` extends to a relation
`(c̃, -d)` of the augmented matrix `[A | diag(g)]` (row `i`: `a_{i1}, …, a_{ip}` and `g₁, …, g_l`
in its own block of columns). By coherence of `𝒪_X` the relations of the augmented matrix are
generated near `z` by finitely many sections `R_n`; the classes of their first `p` components
generate the relations of `F` at every point near `z`: their classes are relations because the
remaining components exhibit `Σ_j a_{ij} R_{n,j}` as an element of `𝒥`, and every relation `c`
lifts to a relation `(c̃, -d)`, a combination of the `R_n`, whose first components reduce to `c`.
The identification of the stalk of the quotient at `w` with `𝒪_{X,w}/𝒥_w` enters only through
the canonical stalk map `𝒪_{X,w} → 𝒪_{Z,w}` (surjective with kernel `𝒥_w`: `stalkMap_surjective`,
`ker_stalkMap_ι`) and its compatibility with germs (`stalkMap_ι_germ`, `germ_eq_stalkMap_ι_germ`).
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite Manifold

universe u

namespace AnalyticSpace.QuotientSpace

section Algebra

variable {R S : Type*} {p q l : ℕ}

/-- The columns of the augmented matrix `[A | diag(g)]`: `Fin p ⊕ Fin q × Fin l`, flattened. -/
def augCol (p q l : ℕ) : Fin p ⊕ (Fin q × Fin l) ≃ Fin (p + q * l) :=
  (Equiv.sumCongr (Equiv.refl _) finProdFinEquiv).trans finSumFinEquiv

/-- The augmented vector `(c, d)`. -/
def augVec (c : Fin p → R) (d : Fin q → Fin l → R) : Fin (p + q * l) → R :=
  fun x => Sum.elim c (fun t => d t.1 t.2) ((augCol p q l).symm x)

theorem augVec_inl (c : Fin p → R) (d : Fin q → Fin l → R) (j : Fin p) :
    augVec c d (augCol p q l (Sum.inl j)) = c j := by
  simp [augVec]

theorem augVec_inr (c : Fin p → R) (d : Fin q → Fin l → R) (t : Fin q × Fin l) :
    augVec c d (augCol p q l (Sum.inr t)) = d t.1 t.2 := by
  simp [augVec]

variable [CommRing R] [CommRing S]

/-- The augmented matrix `[A | diag(g)]`: row `i` is `A i` followed by `g` in the `i`-th block of
`l` columns and `0` in the other blocks. -/
def augMat (A : Fin q → Fin p → R) (g : Fin l → R) : Fin q → Fin (p + q * l) → R :=
  fun i c => Sum.elim (A i) (fun t : Fin q × Fin l => if t.1 = i then g t.2 else 0)
    ((augCol p q l).symm c)

theorem map_augMat (f : R →+* S) (A : Fin q → Fin p → R) (g : Fin l → R) (i : Fin q)
    (c : Fin (p + q * l)) :
    f (augMat A g i c) = augMat (fun i j => f (A i j)) (fun m => f (g m)) i c := by
  unfold augMat
  rcases (augCol p q l).symm c with j | t
  · rfl
  · simp only [Sum.elim_inr]
    split_ifs <;> simp

theorem sum_augMat_mul (A : Fin q → Fin p → R) (g : Fin l → R) (v : Fin (p + q * l) → R)
    (i : Fin q) :
    ∑ c, augMat A g i c * v c =
      ∑ j, A i j * v (augCol p q l (Sum.inl j)) +
        ∑ m, g m * v (augCol p q l (Sum.inr (i, m))) := by
  classical
  rw [← Equiv.sum_comp (augCol p q l) (fun c => augMat A g i c * v c)]
  simp only [augMat, Equiv.symm_apply_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr,
    Fintype.sum_prod_type, ite_mul, zero_mul]
  congr 1
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [Finset.sum_ite_eq' Finset.univ i]
  simp

/-- The row sums of the augmented matrix after a ring homomorphism (the germ at a point). -/
theorem sum_map_augMat_mul (φ : R →+* S) (A : Fin q → Fin p → R) (g : Fin l → R)
    (v : Fin (p + q * l) → S) (i : Fin q) :
    ∑ c, φ (augMat A g i c) * v c =
      ∑ j, φ (A i j) * v (augCol p q l (Sum.inl j)) +
        ∑ m, φ (g m) * v (augCol p q l (Sum.inr (i, m))) := by
  rw [← sum_augMat_mul (fun i j => φ (A i j)) (fun m => φ (g m)) v i]
  exact Finset.sum_congr rfl fun c _ => by rw [map_augMat]

end Algebra

variable (X : LocallyRingedSpace.{u}) (J : IdealSheaf X.𝒪)

/-- The quotient `(S(𝒥), (𝒪_X/𝒥)|_{S(𝒥)})` of a space with coherent structure sheaf by an ideal
sheaf of finite type has coherent structure sheaf ([Fre17, Ch. V, 7.3]; [BM97, (3.8)(3)] for
the local models). -/
theorem isCoherent_quotientSpace (hX : IsCoherent X.𝒪) : IsCoherent (quotientSpace X J).𝒪 := by
  intro V p q F z hzV
  classical
  -- ambient representatives of the entries near `z`
  have hrep : ∀ ij : Fin q × Fin p, ∃ (U' : Opens (support X J)) (_ : z ∈ U') (i : U' ⟶ V)
      (W : Opens X) (a : X.𝒪.presheaf.obj (op W)), ∀ w : U', ∃ hw : w.1.1 ∈ W,
        (F ij.1 ij.2).1 (i w) = Ideal.Quotient.mk _ (X.𝒪.presheaf.germ W w.1.1 hw a) := fun ij => by
    obtain ⟨U', hz', i, W, a, h⟩ := (F ij.1 ij.2).2 ⟨z, hzV⟩
    exact ⟨U', hz', i, W, a, h⟩
  choose U' hzU' ι' W' a' ha' using hrep
  -- local generators of `𝒥` at `z`
  obtain ⟨W₀, hzW₀, l, g, -, hgen⟩ := J.exists_generators z.1
  -- the common ambient open and the common open of the support
  obtain ⟨Wc, hWc⟩ : ∃ Wc : Opens X, Wc = W₀ ⊓ Finset.univ.inf W' := ⟨_, rfl⟩
  have hWcW₀ : Wc ≤ W₀ := hWc ▸ inf_le_left
  have hWcW' : ∀ ij, Wc ≤ W' ij := fun ij =>
    hWc ▸ inf_le_right.trans (finset_inf_opens_le _ _ (Finset.mem_univ ij))
  have hzWc : z.1 ∈ Wc := by
    rw [hWc, ← SetLike.mem_coe, Opens.coe_inf]
    exact ⟨hzW₀, mem_finset_inf_opens _ _ fun ij _ => (ha' ij ⟨z, hzU' ij⟩).1⟩
  obtain ⟨Vc, hVc⟩ : ∃ Vc : Opens (support X J),
      Vc = V ⊓ Finset.univ.inf U' ⊓ preimage X J Wc := ⟨_, rfl⟩
  have hVcV : Vc ≤ V := hVc ▸ inf_le_left.trans inf_le_left
  have hVcU' : ∀ ij, Vc ≤ U' ij := fun ij =>
    hVc ▸ inf_le_left.trans (inf_le_right.trans (finset_inf_opens_le _ _ (Finset.mem_univ ij)))
  have hVcW : ∀ w, w ∈ Vc → w.1 ∈ Wc := fun w hw => (hVc ▸ inf_le_right : Vc ≤ preimage X J Wc) hw
  have hzVc : z ∈ Vc := by
    rw [hVc, ← SetLike.mem_coe, Opens.coe_inf, Opens.coe_inf]
    exact ⟨⟨hzV, mem_finset_inf_opens _ _ fun ij _ => hzU' ij⟩, hzWc⟩
  -- the ambient matrix and the generators of `𝒥`, over `Wc`
  obtain ⟨A, hA⟩ : ∃ A : Fin q → Fin p → X.𝒪.presheaf.obj (op Wc),
      A = fun i j => X.𝒪.presheaf.map (homOfLE (hWcW' (i, j))).op (a' (i, j)) := ⟨_, rfl⟩
  obtain ⟨gW, hgW⟩ : ∃ gW : Fin l → X.𝒪.presheaf.obj (op Wc),
      gW = fun m => X.𝒪.presheaf.map (homOfLE hWcW₀).op (g m) := ⟨_, rfl⟩
  -- the germs of `F` are the classes of the germs of `A`
  have hgermF : ∀ (i j) (w : support X J) (hw : w ∈ Vc),
      (quotientSpace X J).𝒪.presheaf.germ V w (hVcV hw) (F i j) =
        ((ι X J).stalkMap w).hom (X.𝒪.presheaf.germ Wc w.1 (hVcW w hw) (A i j)) := by
    intro i j w hw
    obtain ⟨O, hO⟩ := exists_opens_eq_preimage X J (U' (i, j))
    have hwU' : w ∈ U' (i, j) := hVcU' (i, j) hw
    have hwO : w.1 ∈ O := by rw [hO] at hwU'; exact hwU'
    have hloc : ∀ w' : support X J, w'.1 ∈ O → ∃ (hw : w' ∈ V) (hwW : w'.1 ∈ W' (i, j)),
        (F i j).1 ⟨w', hw⟩ =
          Ideal.Quotient.mk _ (X.𝒪.presheaf.germ (W' (i, j)) w'.1 hwW (a' (i, j))) := by
      intro w' hw'O
      have hw'U' : w' ∈ U' (i, j) := by rw [hO]; exact hw'O
      obtain ⟨hw'W, e⟩ := ha' (i, j) ⟨w', hw'U'⟩
      exact ⟨(ι' (i, j)).le hw'U', hw'W, e⟩
    obtain ⟨hwW, he⟩ := germ_eq_stalkMap_ι_germ X J (F i j) (hVcV hw) (a' (i, j)) hwO hloc
    have hAeq : X.𝒪.presheaf.germ Wc w.1 (hVcW w hw) (A i j) =
        X.𝒪.presheaf.germ (W' (i, j)) w.1 hwW (a' (i, j)) := by
      subst hA
      exact TopCat.Presheaf.germ_res_apply X.𝒪.presheaf (homOfLE (hWcW' (i, j))) w.1 (hVcW w hw)
        (a' (i, j))
    exact he.trans (congrArg (((ι X J).stalkMap w).hom) hAeq.symm)
  -- the stalk ideals of `𝒥` on `Vc`
  have hgWgerm : ∀ (w : support X J) (hw : w ∈ Vc) (m : Fin l),
      X.𝒪.presheaf.germ Wc w.1 (hVcW w hw) (gW m) =
        X.𝒪.presheaf.germ W₀ w.1 (hWcW₀ (hVcW w hw)) (g m) := by
    intro w hw m
    subst hgW
    exact TopCat.Presheaf.germ_res_apply X.𝒪.presheaf (homOfLE hWcW₀) w.1 (hVcW w hw) (g m)
  have hJ : ∀ (w : support X J) (hw : w ∈ Vc), J.stalkIdeal w.1 =
      Ideal.span (Set.range fun m => X.𝒪.presheaf.germ Wc w.1 (hVcW w hw) (gW m)) := by
    intro w hw
    rw [hgen w.1 (hWcW₀ (hVcW w hw))]
    congr 1
    ext s
    simp only [Set.mem_range, hgWgerm w hw]
  -- coherence of `𝒪_X` for the augmented matrix
  obtain ⟨W₁, hW₁, hzW₁, k, R, hR⟩ := hX Wc (p + q * l) q (augMat A gW) z.1 hzWc
  obtain ⟨Vg, hVg⟩ : ∃ Vg : Opens (support X J), Vg = Vc ⊓ preimage X J W₁ := ⟨_, rfl⟩
  have hVgVc : Vg ≤ Vc := hVg ▸ inf_le_left
  have hVgV₁ : Vg ≤ preimage X J W₁ := hVg ▸ inf_le_right
  have hVgW₁ : ∀ w, w ∈ Vg → w.1 ∈ W₁ := fun w hw => hVgV₁ hw
  have hzVg : z ∈ Vg := by
    rw [hVg, ← SetLike.mem_coe, Opens.coe_inf]
    exact ⟨hzVc, hzW₁⟩
  -- the generators: the classes of the first `p` components of the `R n`
  refine ⟨Vg, hVgVc.trans hVcV, hzVg, k, fun n j => (quotientSpace X J).𝒪.presheaf.map
    (homOfLE hVgV₁).op (classFamily X J W₁ (R n (augCol p q l (Sum.inl j)))), fun w hw => ?_⟩
  have hwVc : w ∈ Vc := hVgVc hw
  have hwW₁ : w.1 ∈ W₁ := hVgW₁ w hw
  obtain ⟨σ, hσ⟩ : ∃ σ : X.𝒪.presheaf.stalk w.1 →+* (quotientSpace X J).𝒪.presheaf.stalk w,
      σ = ((ι X J).stalkMap w).hom := ⟨_, rfl⟩
  have hσsurj : Function.Surjective σ := hσ ▸ stalkMap_surjective X J w
  have hkerσ : RingHom.ker σ = J.stalkIdeal w.1 := by
    rw [hσ]; exact ker_stalkMap_ι X J w
  have hker : ∀ s, σ s = 0 ↔ s ∈ J.stalkIdeal w.1 := fun s => by
    rw [← hkerσ]; exact RingHom.mem_ker.symm
  have hgr : ∀ n j, (quotientSpace X J).𝒪.presheaf.germ Vg w hw ((quotientSpace X J).𝒪.presheaf.map
      (homOfLE hVgV₁).op (classFamily X J W₁ (R n (augCol p q l (Sum.inl j))))) =
        σ (X.𝒪.presheaf.germ W₁ w.1 hwW₁ (R n (augCol p q l (Sum.inl j)))) := fun n j => by
    rw [hσ]
    exact (TopCat.Presheaf.germ_res_apply (quotientSpace X J).𝒪.presheaf (homOfLE hVgV₁) w hw
      (classFamily X J W₁ (R n (augCol p q l (Sum.inl j))))).trans
      (stalkMap_ι_germ X J W₁ w hwW₁ _).symm
  have hgF : ∀ i j, (quotientSpace X J).𝒪.presheaf.germ V w (hVcV hwVc) (F i j) =
      σ (X.𝒪.presheaf.germ Wc w.1 (hVcW w hwVc) (A i j)) := fun i j => by
    rw [hσ]; exact hgermF i j w hwVc
  -- the relations of the augmented matrix at `w`, in components
  have hrelAug : ∀ v : Fin (p + q * l) → X.𝒪.presheaf.stalk w.1,
      v ∈ relationSubmodule X.𝒪 (augMat A gW) w.1 (hW₁ hwW₁) ↔ ∀ i,
        ∑ j, X.𝒪.presheaf.germ Wc w.1 (hVcW w hwVc) (A i j) * v (augCol p q l (Sum.inl j)) +
          ∑ m, X.𝒪.presheaf.germ Wc w.1 (hVcW w hwVc) (gW m) *
            v (augCol p q l (Sum.inr (i, m))) = 0 := by
    intro v
    rw [mem_relationSubmodule_iff]
    refine forall_congr' fun i => ?_
    have h2 : ∀ c, X.𝒪.presheaf.germ Wc w.1 (hW₁ hwW₁) (augMat A gW i c) =
        augMat (fun i j => X.𝒪.presheaf.germ Wc w.1 (hVcW w hwVc) (A i j))
          (fun m => X.𝒪.presheaf.germ Wc w.1 (hVcW w hwVc) (gW m)) i c :=
      fun c => map_augMat (X.𝒪.presheaf.germ Wc w.1 (hW₁ hwW₁)).hom A gW i c
    simp only [h2]
    rw [sum_augMat_mul]
  have hRw : relationSubmodule X.𝒪 (augMat A gW) w.1 (hW₁ hwW₁) =
      Submodule.span _ (Set.range fun n c => X.𝒪.presheaf.germ W₁ w.1 hwW₁ (R n c)) :=
    hR w.1 hwW₁
  have hRrel : ∀ n, (fun c => X.𝒪.presheaf.germ W₁ w.1 hwW₁ (R n c)) ∈
      relationSubmodule X.𝒪 (augMat A gW) w.1 (hW₁ hwW₁) := fun n => by
    rw [hRw]
    exact Submodule.subset_span ⟨n, rfl⟩
  ext c
  constructor
  · intro hc
    have hc' := (mem_relationSubmodule_iff _ _ _).mp hc
    choose ct hct using fun j => hσsurj (c j)
    have hmem : ∀ i, ∑ j, X.𝒪.presheaf.germ Wc w.1 (hVcW w hwVc) (A i j) * ct j ∈
        J.stalkIdeal w.1 := by
      intro i
      rw [← hker, map_sum]
      simp only [map_mul, hct, ← hgF]
      exact hc' i
    have hd : ∀ i, ∃ d : Fin l → X.𝒪.presheaf.stalk w.1,
        ∑ m, d m * X.𝒪.presheaf.germ Wc w.1 (hVcW w hwVc) (gW m) =
          ∑ j, X.𝒪.presheaf.germ Wc w.1 (hVcW w hwVc) (A i j) * ct j := fun i => by
      have := hmem i
      rwa [hJ w hwVc, Ideal.mem_span_range_iff_exists_fun] at this
    choose d hd using hd
    have haug : augVec ct (fun i m => -d i m) ∈
        relationSubmodule X.𝒪 (augMat A gW) w.1 (hW₁ hwW₁) := by
      rw [hrelAug]
      intro i
      simp only [augVec_inl, augVec_inr, mul_neg, Finset.sum_neg_distrib]
      rw [← hd i, ← sub_eq_add_neg, sub_eq_zero]
      exact Finset.sum_congr rfl fun m _ => mul_comm _ _
    rw [hRw, Submodule.mem_span_range_iff_exists_fun] at haug
    obtain ⟨lam, hlam⟩ := haug
    rw [Submodule.mem_span_range_iff_exists_fun]
    refine ⟨fun n => σ (lam n), ?_⟩
    funext j
    have h3 := congrFun hlam (augCol p q l (Sum.inl j))
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, augVec_inl] at h3
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, hgr]
    rw [← hct j, ← h3, map_sum]
    simp only [map_mul]
  · intro hc
    rw [Submodule.mem_span_range_iff_exists_fun] at hc
    obtain ⟨lam, rfl⟩ := hc
    rw [mem_relationSubmodule_iff]
    intro i
    have hn : ∀ n, ∑ j, (quotientSpace X J).𝒪.presheaf.germ V w (hVcV hwVc) (F i j) *
        (quotientSpace X J).𝒪.presheaf.germ Vg w hw ((quotientSpace X J).𝒪.presheaf.map
          (homOfLE hVgV₁).op (classFamily X J W₁ (R n (augCol p q l (Sum.inl j))))) = 0 :=
      fun n => by
      simp only [hgF, hgr, ← map_mul, ← map_sum]
      rw [hker, hJ w hwVc, Ideal.mem_span_range_iff_exists_fun]
      have h4 := (hrelAug _).mp (hRrel n) i
      refine ⟨fun m => -X.𝒪.presheaf.germ W₁ w.1 hwW₁ (R n (augCol p q l (Sum.inr (i, m)))), ?_⟩
      have h5 : ∑ m, -X.𝒪.presheaf.germ W₁ w.1 hwW₁ (R n (augCol p q l (Sum.inr (i, m)))) *
          X.𝒪.presheaf.germ Wc w.1 (hVcW w hwVc) (gW m) =
          -∑ m, X.𝒪.presheaf.germ Wc w.1 (hVcW w hwVc) (gW m) *
            X.𝒪.presheaf.germ W₁ w.1 hwW₁ (R n (augCol p q l (Sum.inr (i, m)))) := by
        rw [← Finset.sum_neg_distrib]
        exact Finset.sum_congr rfl fun m _ => by ring
      rw [h5, neg_eq_iff_eq_neg, eq_neg_iff_add_eq_zero, add_comm]
      exact h4
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_eq_zero fun n _ => ?_
    simp only [mul_left_comm _ (lam n), ← Finset.mul_sum]
    rw [hn n, mul_zero]

end AnalyticSpace.QuotientSpace
