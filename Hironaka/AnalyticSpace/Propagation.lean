module

public import Hironaka.Manifold.IdealSheaf.Defs
import Hironaka.Manifold.IdealSheaf.Basic
import Mathlib.Algebra.Category.Ring.FilteredColimits
import Mathlib.Analysis.SpecialFunctions.Pow.NNReal

/-!
# Finite-type propagation of stalk equalities

If the stalk `𝒥_x` of an ideal sheaf `𝒥` with local generators `g₁, …, g_k` near `x` is
generated by the germs of sections `h₁, …, h_c`, then `𝒥_y` is generated by their germs for every
`y` in a neighbourhood of `x` — "`𝒥 = (h₁, …, h_c)` on a neighbourhood". The two ingredients are
elementary facts about germs of a presheaf of commutative rings: membership of a germ in a stalk
ideal spreads to a neighbourhood (`mem_stalkIdeal_iff` hands over a section of `𝒥` with the same
germ, `germ_eq` a neighbourhood where the sections agree), and membership of a germ in the ideal
generated by finitely many germs spreads likewise (each coefficient is a germ of a section,
`germ_eq` again). Hironaka's passage from the local ring to a neighbourhood in the
Jacobian-criterion sentence [Hir64, Ch. 0, §1, p. 121] — from `𝓘_x = (h)_x` to `X = V(h)` near
`x` — uses this. Not in the sources as a stated result; routine.

* `exists_forall_germ_mem_stalkIdeal`: a germ in `𝒥_x` is in `𝒥_y` for `y` near `x`;
* `exists_forall_germ_mem_span`: a germ in `(germ_x h)` is in `(germ_y h)` for `y` near `x`;
* `exists_stalkIdeal_eq_span_of_stalkIdeal_eq_span`: the propagation.
-/

public noncomputable section

open CategoryTheory TopologicalSpace Opposite Manifold

universe u

namespace AnalyticSpace

/-- Membership in a finite infimum of opens. -/
theorem mem_iInf_opens {α : Type*} [TopologicalSpace α] {ι : Type*} [Finite ι] {V : ι → Opens α}
    {x : α} : x ∈ ⨅ i, V i ↔ ∀ i, x ∈ V i := by
  rw [← SetLike.mem_coe, Opens.coe_iInf, Set.mem_iInter]
  rfl

variable {X : TopCat.{u}} (F : TopCat.Presheaf CommRingCat.{u} X)

/-- Membership of a germ in the ideal generated by finitely many germs spreads to a
neighbourhood: if `germ_x s ∈ (germ_x h₁, …, germ_x h_c)`, then
`germ_y s ∈ (germ_y h₁, …, germ_y h_c)` for all `y` in some open `W ≤ U` containing `x`. -/
theorem exists_forall_germ_mem_span {U : Opens X} {x : X} (hx : x ∈ U) (s : F.obj (op U)) {c : ℕ}
    (h : Fin c → F.obj (op U))
    (hs : F.germ U x hx s ∈ Ideal.span (Set.range fun i => F.germ U x hx (h i))) :
    ∃ (W : Opens X) (_ : x ∈ W) (hWU : W ≤ U), ∀ y (hy : y ∈ W),
      F.germ U y (hWU hy) s ∈ Ideal.span (Set.range fun i => F.germ U y (hWU hy) (h i)) := by
  classical
  obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hs
  -- each coefficient is the germ of a section on a neighbourhood
  choose V hxV t ht using fun i => F.exists_germ_eq (a i)
  -- a common neighbourhood
  let V₀ : Opens X := U ⊓ ⨅ i, V i
  have hxV₀ : x ∈ V₀ := Opens.mem_inf.mpr ⟨hx, mem_iInf_opens.mpr hxV⟩
  have hV₀U : V₀ ≤ U := inf_le_left
  have hV₀V : ∀ i, V₀ ≤ V i := fun i => inf_le_right.trans (iInf_le _ i)
  -- the combination as a section on `V₀`
  let σ : F.obj (op V₀) := ∑ i, F.map (homOfLE (hV₀V i)).op (t i) * F.map (homOfLE hV₀U).op (h i)
  have hσ : F.germ V₀ x hxV₀ σ = F.germ U x hx s := by
    rw [← ha]
    simp only [σ, map_sum, map_mul, F.germ_res_apply, ht]
  obtain ⟨W, hxW, iW, iV₀, hW⟩ := F.germ_eq x hx hxV₀ s σ hσ.symm
  refine ⟨W, hxW, leOfHom iW, fun y hy => ?_⟩
  have hyV₀ : y ∈ V₀ := leOfHom iV₀ hy
  have : F.germ U y (leOfHom iW hy) s = F.germ V₀ y hyV₀ σ := by
    rw [← F.germ_res_apply iW y hy s, hW, F.germ_res_apply]
  rw [this]
  simp only [σ, map_sum, map_mul, F.germ_res_apply]
  exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

variable {F} (𝒪 : TopCat.Sheaf CommRingCat.{u} X) (J : IdealSheaf 𝒪)

/-- Membership of a germ in a stalk ideal spreads to a neighbourhood: if `germ_x s ∈ 𝒥_x`, then
`germ_y s ∈ 𝒥_y` for all `y` in some open `W ≤ U` containing `x` (`mem_stalkIdeal_iff`: `𝒥_x`
consists of the germs of sections of `𝒥`). -/
theorem exists_forall_germ_mem_stalkIdeal {U : Opens X} {x : X} (hx : x ∈ U)
    (s : 𝒪.presheaf.obj (op U)) (hs : 𝒪.presheaf.germ U x hx s ∈ J.stalkIdeal x) :
    ∃ (W : Opens X) (_ : x ∈ W) (hWU : W ≤ U), ∀ y (hy : y ∈ W),
      𝒪.presheaf.germ U y (hWU hy) s ∈ J.stalkIdeal y := by
  obtain ⟨V, hxV, g, hg, hgs⟩ := J.mem_stalkIdeal_iff.mp hs
  obtain ⟨W, hxW, iU, iV, hW⟩ := 𝒪.presheaf.germ_eq x hx hxV s g hgs.symm
  refine ⟨W, hxW, leOfHom iU, fun y hy => ?_⟩
  rw [← 𝒪.presheaf.germ_res_apply iU y hy s, hW]
  exact J.germ_mem_stalkIdeal hy (J.res_mem iV g hg)

/-- The finite-type propagation: if an ideal sheaf `𝒥` has local generators `g₁, …, g_k` near `x`
(its stalks at the points of `U ∋ x` are generated by their germs) and the stalk `𝒥_x` is
generated by the germs of sections `h₁, …, h_c` over `U`, then `𝒥_y` is generated by their germs
for every `y` in a neighbourhood `V ⊆ U` of `x`. -/
theorem exists_stalkIdeal_eq_span_of_stalkIdeal_eq_span {U : Opens X} {x : X} (hx : x ∈ U)
    {k : ℕ} (g : Fin k → 𝒪.presheaf.obj (op U))
    (hg : ∀ y (hy : y ∈ U),
      J.stalkIdeal y = Ideal.span (Set.range fun i => 𝒪.presheaf.germ U y hy (g i)))
    {c : ℕ} (h : Fin c → 𝒪.presheaf.obj (op U))
    (hJ : J.stalkIdeal x = Ideal.span (Set.range fun i => 𝒪.presheaf.germ U x hx (h i))) :
    ∃ (V : Opens X) (_ : x ∈ V) (i : V ⟶ U), ∀ y (hy : y ∈ V),
      J.stalkIdeal y =
        Ideal.span (Set.range fun j => 𝒪.presheaf.germ V y hy (𝒪.presheaf.map i.op (h j))) := by
  classical
  -- the `h i` lie in `𝒥` near `x`
  have hh : ∀ i, ∃ (W : Opens X) (_ : x ∈ W) (hWU : W ≤ U), ∀ y (hy : y ∈ W),
      𝒪.presheaf.germ U y (hWU hy) (h i) ∈ J.stalkIdeal y := fun i =>
    exists_forall_germ_mem_stalkIdeal 𝒪 J hx (h i) (hJ ▸ Ideal.subset_span ⟨i, rfl⟩)
  choose W hxW hWU hW using hh
  -- the `g j` lie in `(h)` near `x`
  have hgg : ∀ j, ∃ (W : Opens X) (_ : x ∈ W) (hWU : W ≤ U), ∀ y (hy : y ∈ W),
      𝒪.presheaf.germ U y (hWU hy) (g j) ∈
        Ideal.span (Set.range fun i => 𝒪.presheaf.germ U y (hWU hy) (h i)) := fun j =>
    exists_forall_germ_mem_span 𝒪.presheaf hx (g j) h (hJ ▸ hg x hx ▸ Ideal.subset_span ⟨j, rfl⟩)
  choose W' hxW' hW'U hW' using hgg
  let V : Opens X := U ⊓ (⨅ i, W i) ⊓ ⨅ j, W' j
  have hxV : x ∈ V := Opens.mem_inf.mpr ⟨Opens.mem_inf.mpr ⟨hx, mem_iInf_opens.mpr hxW⟩,
    mem_iInf_opens.mpr hxW'⟩
  have hVU : V ≤ U := inf_le_left.trans inf_le_left
  have hVW : ∀ i, V ≤ W i := fun i => inf_le_left.trans (inf_le_right.trans (iInf_le _ i))
  have hVW' : ∀ j, V ≤ W' j := fun j => inf_le_right.trans (iInf_le _ j)
  refine ⟨V, hxV, homOfLE hVU, fun y hy => ?_⟩
  simp only [𝒪.presheaf.germ_res_apply]
  apply le_antisymm
  · rw [hg y (hVU hy), Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact hW' j y (hVW' j hy)
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hW i y (hVW i hy)

end AnalyticSpace
