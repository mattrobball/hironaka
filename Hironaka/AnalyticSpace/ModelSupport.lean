module

public import Hironaka.AnalyticSpace.Model
import Hironaka.Manifold.IdealSheaf.Basic
import Hironaka.Manifold.Sheaf.LocalRing
import Mathlib.Analysis.SpecialFunctions.Pow.NNReal

/-!
# The support of a local model is the zero set of its equations

The local analytic `K`-space `(S(𝓘), (𝒜_G/𝓘)|_{S(𝓘)})`, `𝓘 = (f₁, …, f_k)`, has support
`S(𝓘) = supp (𝒜_G/𝓘) = {x ∈ G | f₁(x) = ⋯ = f_k(x) = 0}` [Hir64, Ch. 0, §1]. The stalk `𝓘_x` is
generated by the germs of the `f_i`; in the local ring `𝒜_{G,x}` an ideal generated by a set is
the unit ideal iff the set contains a unit (`Ideal.span_eq_top_iff_exists_isUnit`); and a germ of
`𝒜_{Kⁿ}` is a unit iff its value is nonzero, read through Mathlib's identification of the stalk
of the restricted sheaf `𝒜_G` with the stalk of `𝒜_{Kⁿ}` (`restrictStalkIso`). The point-set
description `mem_range_localModel_ι_iff` is what identifies an open subspace of a local model
with a local model (`Hironaka/AnalyticSpace/LocalModelRestrict.lean`).
-/

public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite Manifold
open scoped Manifold ContDiff

universe u

namespace AnalyticSpace

variable (K : Type) [RCLike K] (n : ℕ)

/-- A germ at `x ∈ U` of an analytic function on `U ⊆ Kⁿ` is a unit of `𝒜_{Kⁿ,x}` iff its value
at `x` is nonzero. -/
theorem isUnit_germ_affine_iff (U : Opens (Kn.{u} K n)) (x : U) (g : AnalyticFun K n U) :
    IsUnit ((affine K n).toLocallyRingedSpace.presheaf.germ U x.1 x.2 g) ↔ g.eval x ≠ 0 := by
  change IsUnit ((contMDiffSheafCommRing 𝓘(K, Kn.{u} K n) 𝓘(K) ω (Kn.{u} K n) K).presheaf.germ
    U x.1 x.2 g) ↔ _
  refine (contMDiffSheafCommRing.isUnit_stalk_iff 𝓘(K, Kn.{u} K n) ω (Kn.{u} K n) _).trans ?_
  rw [contMDiffSheafCommRing.eval_germ]
  exact Iff.rfl

/-- The germ at `x ∈ G` of a global section of `𝒜_G` corresponds, under the identification of the
stalk of `𝒜_G` with `𝒜_{Kⁿ,x}`, to the germ of the analytic function it comes from. -/
theorem restrictStalkIso_germ_toGlobal (G : Opens (Kn.{u} K n))
    (x : analyticSpaceOfOpen K n G) (g : AnalyticFun K n G) :
    ((affine K n).toLocallyRingedSpace.restrictStalkIso
      (Opens.isOpenEmbedding (X := (affine K n).toLocallyRingedSpace.toTopCat) G) x).hom
      ((analyticSpaceOfOpen K n G).toLocallyRingedSpace.presheaf.germ ⊤ x (Opens.mem_top x)
        (toGlobal K n G g)) =
      (affine K n).toLocallyRingedSpace.presheaf.germ G x.1 x.2 g := by
  erw [LocallyRingedSpace.restrictStalkIso_hom_eq_germ_apply]
  exact TopCat.Presheaf.germ_res_apply _ _ _ _ g

/-- The germ at `x ∈ G` of a global section of `𝒜_G` is a unit iff the value at `x` of the
analytic function it comes from is nonzero. -/
theorem isUnit_germ_toGlobal_iff (G : Opens (Kn.{u} K n)) (x : analyticSpaceOfOpen K n G)
    (g : AnalyticFun K n G) :
    IsUnit ((analyticSpaceOfOpen K n G).toLocallyRingedSpace.presheaf.germ ⊤ x (Opens.mem_top x)
      (toGlobal K n G g)) ↔ g.eval x ≠ 0 := by
  rw [← isUnit_germ_affine_iff K n G x g, ← restrictStalkIso_germ_toGlobal K n G x g]
  exact (isUnit_map_iff ((affine K n).toLocallyRingedSpace.restrictStalkIso
    (Opens.isOpenEmbedding (X := (affine K n).toLocallyRingedSpace.toTopCat) G) x).hom.hom _).symm

/-- A point of `G` lies in the support `S(𝓘)` of the local model iff every equation `f_i`
vanishes at it [Hir64, Ch. 0, §1]. -/
theorem mem_cosupport_modelIdeal_iff (G : Opens (Kn.{u} K n)) {k : ℕ}
    (f : Fin k → AnalyticFun K n G) (x : analyticSpaceOfOpen K n G) :
    x ∈ (modelIdeal K n G f).support ↔ ∀ i, (f i).eval x = 0 := by
  have : IsLocalRing ((analyticSpaceOfOpen K n G).toLocallyRingedSpace.𝒪.presheaf.stalk x) :=
    inferInstanceAs
      (IsLocalRing ((analyticSpaceOfOpen K n G).toLocallyRingedSpace.presheaf.stalk x))
  rw [IdealSheaf.mem_support, modelIdeal]
  erw [IdealSheaf.stalkIdeal_ofGlobal, ne_eq, Ideal.span_eq_top_iff_exists_isUnit]
  constructor
  · intro h i
    by_contra hne
    exact h ⟨_, ⟨i, rfl⟩, (isUnit_germ_toGlobal_iff K n G x (f i)).mpr hne⟩
  · rintro h ⟨_, ⟨i, rfl⟩, hu⟩
    exact (isUnit_germ_toGlobal_iff K n G x (f i)).mp hu (h i)

/-- The support `S(𝓘)` of the local model, embedded in `Kⁿ`, is the common zero set
`{f₁ = ⋯ = f_k = 0} ⊆ G` [Hir64, Ch. 0, §1]. -/
theorem mem_range_localModel_ι_iff (G : Opens (Kn.{u} K n)) {k : ℕ}
    (f : Fin k → AnalyticFun K n G) (p : Kn.{u} K n) :
    p ∈ Set.range (KLocallyRingedSpace.Hom.toFun (localModel.ι K n G f)) ↔
      ∃ hp : p ∈ G, ∀ i, (f i).eval ⟨p, hp⟩ = 0 := by
  constructor
  · rintro ⟨z, rfl⟩
    exact ⟨z.1.2, (mem_cosupport_modelIdeal_iff K n G f z.1).mp z.2⟩
  · rintro ⟨hp, hf⟩
    exact ⟨⟨⟨p, hp⟩, (mem_cosupport_modelIdeal_iff K n G f ⟨p, hp⟩).mpr hf⟩, rfl⟩

end AnalyticSpace
